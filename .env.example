DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5555/auth/discord/callback
SESSION_SECRET=change-me

# Comma-separated Discord user IDs.
# ALLOWED_DISCORD_IDS accepts plain driver IDs or id:role entries.
# Example: 111111111111111111,222222222222222222:spectator
ADMIN_DISCORD_IDS=
ALLOWED_DISCORD_IDS=

# Lobby defaults.
DEFAULT_DRIVE_SECONDS=120
MAX_REMOTE_SPEED_PERCENT=70

# Race engine (D15). During a race these OWN the speed ceiling — the lobby
# cap above does not apply. Governor limits all cars; boost unlocks full power.
# RACE_GOVERNOR_PERCENT=70
# RACE_BOOST_SECONDS=5
# RACE_BOOST_COOLDOWN_SECONDS=15
# RACE_BOOST_MAX_PERCENT=100

# Car connection defaults.
FPV_CAR_IP=172.16.11.1
FPV_LISTEN_PORT=1234

# Local video latency tuning.
JPEG_QUALITY=55
VIDEO_DECODE_QUEUE=8

# Safety: force neutral if the active driver's client goes silent this long.
CONTROL_SILENCE_SECONDS=3

# Persistent drive codes (replaces the removed hardcoded ZEN* backdoor).
# Format: CODE:role,CODE2:role — roles: driver|admin
# PERSISTENT_CODES=MY-GUEST-CODE:driver,MY-ADMIN-CODE:admin

# Debug helper /api/guest/test (counts only) — keep 0 in production.
ENABLE_TEST_CODES=0
