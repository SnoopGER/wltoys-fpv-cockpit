DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5555/auth/discord/callback
SESSION_SECRET=change-me

# Comma-separated Discord user IDs.
# ALLOWED_DISCORD_IDS accepts plain driver IDs or id:role entries.
# Example: 111111111111111111,222222222222222222:spectator
ADMIN_DISCORD_IDS=
ALLOWED_DISCORD_IDS=

# Lobby defaults.
DEFAULT_DRIVE_SECONDS=120
MAX_REMOTE_SPEED_PERCENT=70

# Car connection defaults.
FPV_CAR_IP=172.16.11.1
FPV_LISTEN_PORT=1234

# Local video latency tuning.
JPEG_QUALITY=55
VIDEO_DECODE_QUEUE=8
